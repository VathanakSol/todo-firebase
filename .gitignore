# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors (personal settings; shared VS Code settings can still be committed)
.idea/
*.swp
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# claude code (personal, per-machine settings)
.claude/settings.local.json

# firebase
.firebase/
.firebaserc.local
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*
# Admin SDK service account keys: these give full access to the project
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# a template listing the variable names, without real values, may be committed
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
